type Query {
    employee: [employee]
    employeeById(employeeId: ID): Employee
}

type Employee {
    employeeId: String!
    name: String!
    dateOfBirth: String!
    city: String!
    salary: number!
    gender: String!
    email: String
}

input CreateEmployeeInput {
    name: String,
    dateOfBirth: String,
    city: String,
    salary: number,
    gender: String,
    email: String
}

type Mutation {
    newEmployee(CreateEmployeeInput: CreateEmployeeInput!) : Employee!
}