type Query {
    employee: [Employee]
    employeeById(employeeId: ID!): Employee
}

type Employee {
    employeeId: String
    name: String!
    dateOfBirth: String!
    city: String!
    salary: Float!
    gender: String!
    email: String!
}

input CreateEmployeeInput {
    name: String!,
    dateOfBirth: String!,
    city: String!,
    salary: Float!,
    gender: String!,
    email: String!
}

type Mutation {
    newEmployee(CreateEmployeeInput: CreateEmployeeInput!) : Employee!
}